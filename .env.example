BOT_TOKEN=your_telegram_bot_token_here
ADMIN_IDS=123456789,987654321
# Optional: custom yt-dlp binary path (default: yt-dlp)
YT_DLP_PATH=yt-dlp
# Optional: path to ffmpeg.exe directory (default: current directory)
# FFMPEG_PATH=./ffmpeg.exe
# Optional: download size cap in MB — larger media is skipped (lower quality
# is tried once first). Default 50, which matches the Bot API upload limit.
MAX_FILE_SIZE_MB=50
# Optional: largest file Telegram's Bot API will accept on upload (default 50MB;
# the cloud API hard-caps sendVideo at 50MB). A download that fits
# MAX_FILE_SIZE_MB but exceeds this is rejected with a clear message instead of
# a cryptic "Request Entity Too Large". Set 0 when you run a local Bot API
# server (supports up to ~2GB).
# TELEGRAM_UPLOAD_LIMIT_MB=50
# Optional: download directory
DOWNLOAD_DIR=./downloads
# Optional: database path
DATABASE_PATH=./data/bot.db
# YouTube cookies: YouTube downloads run through local yt-dlp FIRST (anonymous
# clients) and fall back to the cookie-free HTTPS providers; cookies are only
# needed for age-gated/private/rate-limited videos. The cookie flags below also
# apply to TikTok/X/Instagram via yt-dlp. When cookies ARE needed, pick one:
# 1) Path to a Netscape-format cookies file exported from a logged-in browser
#    (recommended for servers). Export with the "Get cookies.txt LOCALLY"
#    browser extension while logged in at youtube.com, save it as cookies.txt
#    next to the bot. IMPORTANT: never commit cookies.txt to git.
COOKIES_PATH=./cookies.txt
# 1b) YOUTUBE_COOKIE_MODE: auto (default) = anonymous first, cookies fallback.
#    "cookies" = cookies first (old behavior). "never" = never use cookies.
# YOUTUBE_COOKIE_MODE=auto
# 1b) COOKIES_CONTENT: same file, but pasted into an env var (raw text or
#    base64). REQUIRED on Render free plan — its filesystem is ephemeral and
#    an uploaded cookies.txt is wiped on every restart/redeploy. When set,
#    the bot rewrites COOKIES_PATH from this value on every boot.
#    Fastest refresh flow (no restart, no dashboard): send the fresh
#    cookies.txt to the bot in Telegram as an admin — it applies instantly —
#    then also paste it here so it survives restarts.
# COOKIES_CONTENT=
# 2) OR let yt-dlp read cookies directly from a local browser
#    (only works when a browser with a logged-in YouTube session exists on
#    the same machine, e.g. your own PC — not on most servers):
# COOKIES_FROM_BROWSER=chrome
# Optional: YouTube quality cap (default 720). 720p is 3-5x smaller than
# 1080p+, so downloads + Telegram uploads are much faster and still fit the
# 50MB bot limit. Set 1080 or 0 (uncapped) for full quality.
# YOUTUBE_MAX_HEIGHT=720
# Optional: proxy for yt-dlp (when the datacenter IP itself is hard-blocked by
# YouTube, a residential proxy is the only fix). HTTP(S)/SOCKS5 accepted:
# YT_DLP_PROXY=http://user:pass@host:port
# Optional: TLS certificate verification is ON by default. Only set this to
# true if a specific CDN serves a broken certificate chain — it also disables
# protection against tampered downloads (MITM).
# YT_DLP_INSECURE_TLS=false
# --- Alternative (non-yt-dlp) download methods -----------------------------
# YouTube pipeline (yt-dlp PRIMARY, HTTPS fallbacks): the bot downloads via
# local yt-dlp first (per-client rotation, JS challenges, cookies, proxy),
# then falls back through independent HTTPS methods — Cobalt (if configured)
# → youtubei multi-client (ANDROID → IOS → MWEB → WEB → TV, own IP) → Piped
# (12-backend rotation + retry) → Invidious. Public Piped/Invidious are last
# because most instances are dead/API-disabled in 2026.
# Set YOUTUBE_YTDLP_FIRST=false for cookie-free-first order (yt-dlp last).
# yt-dlp is also the primary method for TikTok/X/Instagram (and a Pinterest
# fallback).
# Invidious (YouTube fast path, ON by default, no setup needed): resolves the
# MP4 through a public Invidious instance and downloads it with plain HTTPS —
# no yt-dlp bot-checks, no cookies, no ffmpeg merge (much faster). yt-dlp is
# still the automatic fallback. Set to false to force yt-dlp-only.
# INVIDIOUS_ENABLED=true
# Optional: override the instance list (failover in order, comma-separated).
# Defaults follow https://docs.invidious.io/instances/ — NOTE (2026): most
# public instances disable the API (HTTP 403), so this path is best-effort
# and yt-dlp is the real fallback. Set INVIDIOUS_REFRESH=false to skip the
# live list merge from https://api.invidious.io/instances.json.
# INVIDIOUS_INSTANCES=https://inv.nadeko.net,https://invidious.nerdvpn.de
# INVIDIOUS_REFRESH=true
# Piped (primary cookie-free YouTube path, ON by default): federated network
# of public backends. Tried before Invidious; PIPED_REFRESH (default on)
# merges the live official instance list at runtime so dead backends are
# replaced without a redeploy. Override list or disable:
# PIPED_ENABLED=true
# PIPED_INSTANCES=https://pipedapi.ducks.party,https://api.piped.private.coffee
# PIPED_REFRESH=true
# Optional: Cobalt API (all platforms, needs YOUR self-hosted instance —
# public cobalt.tools is blocked for YouTube since 2025). Deploy one via
# Docker (ghcr.io/imputnet/cobalt) or Railway, then set its URL here:
# COBALT_API_URL=https://your-app.up.railway.app
# Optional: API key when your Cobalt instance requires auth.
# COBALT_API_KEY=
# --- yt-dlp hardening (YouTube datacenter bot-checks) ----------------------
# YouTube uses local yt-dlp as its PRIMARY method (per-stack rotation:
# mobile [android,ios,mweb] → embed [web_safari,tv] → defaults → IPv6 retry,
# anonymous first then cookies).
# ON by default; set to false to disable yt-dlp for YouTube entirely
# (HTTPS-only pipeline: Cobalt → Piped → Invidious → youtubei).
# YOUTUBE_YTDLP_FALLBACK=true
# Order toggle: YOUTUBE_YTDLP_FIRST=false puts yt-dlp LAST (cookie-free first).
# YOUTUBE_YTDLP_FIRST=true
# Force IPv4 (default on): Render/IPv6 egress is often the flagged path.
# YT_DLP_FORCE_IPV4=true
# Skip the watch-page scrape for anonymous clients (default on): talk to the
# player API directly (player_skip=webpage,configs).
# YOUTUBE_PLAYER_SKIP=true
# Raw extra args appended to every yt-dlp call (space-separated).
# YT_DLP_EXTRA_ARGS=
# PO-token sidecar (bgutil plugin) base URL, e.g. http://127.0.0.1:4416.
# Requires the plugin (build.sh installs it when POT_PROVIDER=1).
# POT_SERVER_URL=
# Best-effort `yt-dlp -U` self-update on boot (heals stale deploys).
# Recommended ON for Render. Default off locally.
# YTDLP_AUTO_UPDATE=true
# Optional: TikTok fallback API (default true). When yt-dlp is blocked by
# TikTok (IP blocks / API changes), the bot resolves the mp4 via a fallback
# service. Set to false to disable.
TIKTOK_FALLBACK=true
# Optional: stability caps for small hosts (defaults in parentheses — safe as-is).
# MAX_CONCURRENT_DOWNLOADS=2 — max simultaneous downloads across all users
#   (each spawns yt-dlp/ffmpeg children; prevents OOM on 512MB hosts).
# DOWNLOAD_TIMEOUT_MS=300000 — overall per-download budget before a retry message.
# YT_DLP_ATTEMPT_TIMEOUT_MS=150000 — hard timeout per yt-dlp process.
# PUBLIC_API_TIMEOUT_MS=10000 — per-request timeout for Piped/Invidious/youtubei.
# Optional: keep-alive on Render free plan (defaults work, no setup needed).
# The bot answers GET /, /health, /ping with 200 and pings its own /health
# every 10 min to reset Render's ~15 min idle spin-down timer while awake.
# Self-ping can't wake a sleeping instance, so for best results also add a
# free external pinger (UptimeRobot / cron-job.org every 5 min):
#   https://<your-app>.onrender.com/health
# KEEPALIVE_URL=https://<your-app>.onrender.com
# KEEPALIVE_INTERVAL_MINUTES=10
# KEEPALIVE_ENABLED=true
